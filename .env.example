# Copy to .env (gitignored) and fill in. Never commit real values.

# Nebius Token Factory key (starts with "v1.", minted at https://tokenfactory.nebius.com/).
# Not the same thing as the nebius CLI login. Skill: token-factory.
NEBIUS_TOKEN_FACTORY_KEY=

# Model the fleet brain (orchestrator/) calls on Token Factory. Empty = the default,
# deepseek-ai/DeepSeek-V4.1-Flash (owner's test choice); the submission model is
# nvidia/Nemotron-3_5-Lightning (an NVIDIA open model, required by the hackathon rules).
SOLAR_TF_MODEL=

# Nebius AI Cloud — read by scripts/teardown.sh and the CLI profile setup.
NEBIUS_TENANT_ID=
NEBIUS_PROJECT_ID=
NEBIUS_REGION=
NEBIUS_PLATFORM=
NEBIUS_PRESET=

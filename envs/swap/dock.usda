#usda 1.0
(
    defaultPrim = "Dock"
    upAxis = "Z"
    metersPerUnit = 1
    doc = "Drive-over underbody battery-swap dock. Author at origin; C places in world.usd. Owner: B."
)

def Xform "Dock" (
    kind = "assembly"
)
{
    custom string user:role = "battery_swap_dock"
    custom string user:contract = "swap_battery"

    def Xform "frames"
    {
        def Xform "approach"
        {
            double3 xformOp:translate = (0, -1.5, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            custom string user:frame = "approach"
        }

        def Xform "berth"
        {
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            custom string user:frame = "berth"
        }

        def Xform "pack_attach"
        {
            # Tracks carriage top; script may re-parent or drive this with the lift.
            double3 xformOp:translate = (0, 0, 0.16)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            custom string user:frame = "pack_attach"
        }

        def Xform "empty_ready"
        {
            double3 xformOp:translate = (0.45, 0, 0.05)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            custom string user:frame = "empty_ready"
        }

        def Xform "full_stow"
        {
            double3 xformOp:translate = (-0.45, 0, 0.05)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            custom string user:frame = "full_stow"
        }
    }

    def Cube "pad" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        # LOCKED to robot/SPEC.md (15 Sep 2026): must span the 0.80 m track
        # (wheels at y = +/-0.40). Was 0.90 x 0.70, which missed both wheels.
        double size = 1
        float3 xformOp:scale = (1.10, 1.00, 0.04)
        double3 xformOp:translate = (0, 0, 0.02)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.35, 0.35, 0.38)]
    }

    def Xform "base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        bool physics:rigidBodyEnabled = 0
        custom string user:role = "dock_base_static"

        def Cube "housing"
        {
            double size = 1
            float3 xformOp:scale = (0.40, 0.35, 0.08)
            double3 xformOp:translate = (0, 0, 0.06)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            color3f[] primvars:displayColor = [(0.55, 0.45, 0.20)]
        }
    }

    def Xform "lift"
    {
        def Xform "carriage" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 2.0
            double3 xformOp:translate = (0, 0, 0.04)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "plate"
            {
                # Narrowed in X to 0.09 so the carriage rises BETWEEN the pack's
                # retaining straps (x = +/-0.06, inner faces +/-0.048), which
                # hang 2.5 mm below the pack to z = 0.0575. Was 0.28 x 0.18.
                # NOTE the z translates in this Xform tree were authored against
                # the old 0.12 stroke and have NOT been re-derived here - see
                # envs/swap/dock_mjcf.py for the working heights.
                double size = 1
                float3 xformOp:scale = (0.09, 0.40, 0.024)
                double3 xformOp:translate = (0, 0, 0.015)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                color3f[] primvars:displayColor = [(0.80, 0.65, 0.15)]
            }
        }

        def PhysicsPrismaticJoint "lift_joint"
        {
            rel physics:body0 = </Dock/base>
            rel physics:body1 = </Dock/lift/carriage>
            uniform token physics:axis = "Z"
            float physics:lowerLimit = 0
            # LOCKED to robot/SPEC.md: pack underside is 60 mm off the ground.
            # Was 0.12, which drives the carriage into the chassis.
            float physics:upperLimit = 0.060
            float physics:jointFriction = 0
        }
    }

    # Visual placeholders for rack poses (real packs are referenced/instanced at runtime).
    def Cube "empty_rack_marker"
    {
        double size = 1
        float3 xformOp:scale = (0.08, 0.08, 0.02)
        double3 xformOp:translate = (0.45, 0, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.2, 0.7, 0.9)]
    }

    def Cube "full_stow_marker"
    {
        double size = 1
        float3 xformOp:scale = (0.08, 0.08, 0.02)
        double3 xformOp:translate = (-0.45, 0, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.9, 0.4, 0.2)]
    }
}

#usda 1.0
(
    defaultPrim = "SwapStage"
    upAxis = "Z"
    metersPerUnit = 1
    doc = "Authoring composition: dock + sample packs. C does not open this for world edit — only dock.usda sublayer."
)

def Xform "SwapStage"
{
    def "Dock" (
        references = @./dock.usda@
    )
    {
    }

    def "PackFull" (
        references = @./pack.usda@
    )
    {
        double3 xformOp:translate = (0, 0, 0.16)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        custom string user:soc = "full"
    }

    def "PackEmpty" (
        references = @./pack.usda@
    )
    {
        double3 xformOp:translate = (0.45, 0, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        custom string user:soc = "empty"
    }
}
